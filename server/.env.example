# xsnbb 本地开发配置示例。复制为 server/.env 后按需修改；
# 所有外部服务留空即落入开发模式（明确标记 dev_mode，不伪装真实供应商）。

# ---- 基础 ----
APP_ENV=dev
HTTP_ADDR=:8080
SESSION_SECRET=dev-secret-change-me
INVITE_CODE=xsnbb-test
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# ---- 第一个超级管理员（仅首次启动无超管时创建一次，之后改这里不会重置密码）----
SUPER_ADMIN_USER=admin
SUPER_ADMIN_PASSWORD=Admin12345

# ---- 数据库 / 缓存（首版 API 为内存本地数据实现；供 infra/docker-compose.dev.yml 与后续迁移使用）----
DATABASE_URL=postgres://xsnbb:xsnbb@localhost:5432/xsnbb?sslmode=disable
REDIS_ADDR=localhost:6379

# ---- 开发模式上传目录（localOSS 写入，经 /uploads 静态路径提供）----
UPLOAD_DIR=uploads

# ---- 前端构建产物托管（单二进制部署；目录不存在时自动退回纯 API 模式）----
WEB_DIST=../apps/web/dist
ADMIN_DIST=../apps/admin/dist

# ---- 阿里云短信（留空 = 开发模式：验证码随响应 dev_code 返回，仅用于本地联调）----
SMS_ACCESS_KEY=
SMS_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE=

# ---- 阿里云 OSS（留空 = 开发模式：写入本地 UPLOAD_DIR）----
OSS_ACCESS_KEY=
OSS_SECRET=
OSS_ENDPOINT=
OSS_BUCKET=

# ---- 独立联网检索服务（留空 = 开发模式：AI 未命中知识库时明确提示不可用并记录待补充问题）----
SEARCH_BASE_URL=
SEARCH_API_KEY=

# ---- 开发模式内容审核演示违禁词（逗号分隔；生产环境必须接入独立审核服务）----
BANNED_WORDS=代考,枪手,赌博,诈骗
