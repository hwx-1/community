# Copy to infra/.env on the server. Never commit the real .env file.
DOMAIN=xsnbb.xyz

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-characters
POSTGRES_PASSWORD=replace-with-64-hex-characters
SUPER_ADMIN_USER=admin
SUPER_ADMIN_PASSWORD=replace-with-a-strong-unique-password
INVITE_CODE=replace-with-a-private-invite-code

# Optional integrations. Empty values keep the corresponding feature in its
# explicitly labelled development mode.
REDIS_ADDR=
SMS_ACCESS_KEY=
SMS_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE=
OSS_ACCESS_KEY=
OSS_SECRET=
OSS_ENDPOINT=
OSS_BUCKET=
SEARCH_BASE_URL=
SEARCH_API_KEY=
BANNED_WORDS=代考,枪手,赌博,诈骗
